<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
  <appSettings>
    <add key="enabled0001" value="true"/>
    <add key="url0001" value="https://raw.githubusercontent.com/islam2hamy/test/main/d1.html"/>
    <add key="urlPrefix0001" value="="/>
    <add key="destBase0001" value="التبيان-في-أداب-حملة-القرآن.xml"/>
    <add key="destFolderName0001" value=".\podcasts"/>
    <!-- <add key="destFolderName0001" value=".\mp3scraper\bin\Release\podcasts"/> -->
    <!-- http://www.mysite.comn/podcasts/ -->
    <add key="guidPrefix0001" value="التبيان في أداب حملة القرآن - "/>
    <add key="indirect0001" value="false"/>
    <add key="channelTitle0001" value="التبيان في أداب حملة القرآن | الشيخ د. عبد المحسن القاسم"/>
    <add key="channelAuthor0001" value="إسلام بودكاست"/>
    <add key="channelUrl0001" value="https://a-alqasim.com/sounds-explain-cats/التبيان-في-أداب-حملة-القرآن/"/>
    <add key="channelLogo0001" value="https://a-alqasim.com/wp-content/uploads/2021/07/14421122-vlcsnap-2021-07-02-16h28m32s061.jpg"/>
    <add key="channelNotes0001" value=""/>
    <add key="channelDescription0001" value="هو كتاب يُعنى ببيان آداب تلاوة القرآن الكريم وحفظه وتعليمه، موجّهًا خاصة إلى حملة القرآن من القرّاء والحفّاظ وطلاب العلم. يتناول الكتاب مسائل مهمة مثل طهارة القارئ، وآداب المجلس، وإخلاص النية، واحترام المصحف، وآداب المعلم والمتعلم، وغيرها من الأحكام المتعلقة بتعظيم كتاب الله. يتميّز الكتاب باختصاره، ودقة عبارته، واعتماده على الأدلة الشرعية من الكتاب والسنة، مما يجعله مرجعًا نافعًا لكل من أراد تعلّم القرآن والعمل به بأدب وخشوع.
(لمؤلفه الإمام النووى) ."/>
    <add key="itemDescription0001" value="• كتاب : التبيان في أداب حملة القرآن

• المؤلف : أبو زكريا محيي الدين يحيى بن شرف النووي

• تعليق : الشيخ / د. عبدالمحسن بن محمد القاسم

• للمزيد , تابعنا على قناة التيليجرام :
https://t.me/islampodcast1
"/>
    <add key="mp3Bitrat0001" value="32"/>
    <add key="sortDescending0001" value="true"/>
    <add key="retainOrphans0001" value="false"/>
    <add key="stripBaseName0001" value="false"/>
    <add key="refreshDays0001" value="7"/>
    <add key="allowHttps0001" value="false"/>
    <add key="wraparound0001" value="false"/>
    <add key="maxWebRequests0001" value="0"/>
  </appSettings>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri=""/>
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400"/>
      </providers>
    </roleManager>
  </system.web>
</configuration>